# Browser is primary. Use demo only with synthetic local data.
APP_MODE=demo
APP_ORIGIN=http://localhost:3000
WORKSPACE_TIME_ZONE=Asia/Dubai
DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5433/voiceagent
TEST_DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5433/voiceagent_test
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
SHORTCUT_HASH_KEY=
OWNER_SETUP_SECRET=

# Live mode requires configured accounts. Never commit actual credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_ENDPOINT=wss://api.deepgram.com/v1/listen
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback
# owned: calendar.events.owned; shared: calendar.events. Both also use freebusy.
GOOGLE_CALENDAR_OWNERSHIP=shared

# Local pilot selector and real provider overrides (never place actual keys here).
PILOT_LOGIN=true
LANGUAGE_PROVIDER=groq
SPEECH_PROVIDER=deepgram
# Optional supplied remote DB; runtime DATABASE_URL remains a separate explicit choice.
SUPABASE_DATABASE_URL=
