{
  "name": "voice-capture-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "ops:retention": "tsx scripts/retention.ts",
    "ops:usage": "tsx scripts/usage-report.ts",
    "pilot:setup": "tsx scripts/pilot-setup.ts",
    "providers:check": "tsx scripts/provider-check.ts",
    "vercel:configure": "tsx scripts/configure-vercel.ts",
    "build:vercel": "npm run db:migrate && npm run pilot:setup && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "dotenv": "18.0.6",
    "jose": "6.2.12",
    "lucide-react": "1.52.0",
    "luxon": "3.7.2",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
